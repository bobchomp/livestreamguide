<Window x:Class="SmithtonLivestreamGuide.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Width="420" Height="280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="./Fonts/#Poppins">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="Smithton Livestream Guide" FontFamily="./Fonts/#Poppins SemiBold" FontSize="18" Foreground="#16324F"/>
            <TextBlock x:Name="VersionTextBlock" FontSize="13" Foreground="#6B7280" Margin="0,4,0,16"/>
            <TextBlock TextWrapping="Wrap" FontSize="13.5" Foreground="#2B2F36" LineHeight="20"
                       Text="A step-by-step reference for running the Smithton Free Church livestream - power on, cameras, lights, Restream, RTMP Web Player, and the go-live sequence - kept up to date automatically from GitHub Releases."/>
        </StackPanel>

        <Button Grid.Row="1" Content="Close" Click="CloseButton_Click" HorizontalAlignment="Right" Margin="0,20,0,0"
                Padding="18,7" Background="#1E3A5F" Foreground="White" BorderThickness="0"
                FontFamily="./Fonts/#Poppins SemiBold" FontSize="13.5" Cursor="Hand"/>
    </Grid>
</Window>
