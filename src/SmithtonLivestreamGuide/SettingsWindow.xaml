<Window x:Class="SmithtonLivestreamGuide.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="./Fonts/#Poppins">

    <StackPanel Margin="24">
        <TextBlock Text="Settings" FontFamily="./Fonts/#Poppins SemiBold" FontSize="18" Foreground="#16324F"/>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Start with Windows" FontSize="14" Foreground="#2B2F36" VerticalAlignment="Center"/>
            <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Column="1"
                      Style="{StaticResource ToggleSwitchStyle}"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Checked="StartWithWindowsCheckBox_Changed" Unchecked="StartWithWindowsCheckBox_Changed"/>
        </Grid>

        <Button Content="Close" Click="CloseButton_Click" HorizontalAlignment="Right" Margin="0,24,0,0"
                Padding="18,7" Background="#1E3A5F" Foreground="White" BorderThickness="0"
                FontFamily="./Fonts/#Poppins SemiBold" FontSize="13.5" Cursor="Hand"/>
    </StackPanel>
</Window>
