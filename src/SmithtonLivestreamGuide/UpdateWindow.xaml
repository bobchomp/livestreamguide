<Window x:Class="SmithtonLivestreamGuide.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available"
        Width="440" Height="270"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="./Fonts/#Poppins"
        Closing="UpdateWindow_Closing">

    <Border Background="White" CornerRadius="10" BorderBrush="#D8DBE0" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="24" ShadowDepth="4"/>
        </Border.Effect>

        <Grid Margin="28,26,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Prompt state -->
            <StackPanel x:Name="PromptPanel" Grid.Row="0" VerticalAlignment="Center">
                <TextBlock Text="Update available" FontFamily="./Fonts/#Poppins SemiBold" FontSize="19" Foreground="#16324F"/>
                <TextBlock Text="A newer version of the instructions is available. Please update now."
                           FontSize="14" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20"/>
            </StackPanel>

            <!-- Progress state -->
            <StackPanel x:Name="ProgressPanel" Grid.Row="0" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Update available" FontFamily="./Fonts/#Poppins SemiBold" FontSize="19" Foreground="#16324F"/>
                <TextBlock x:Name="StatusTextBlock" Text="Downloading update..." FontSize="14" Foreground="#4B5563" Margin="0,12,0,10"/>
                <ProgressBar x:Name="ProgressBarControl" Height="10" Minimum="0" Maximum="100" Value="0"
                             Background="#E9EBEF" Foreground="#1E3A5F" BorderThickness="0"/>
            </StackPanel>

            <!-- Error state -->
            <StackPanel x:Name="ErrorPanel" Grid.Row="0" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Update failed" FontFamily="./Fonts/#Poppins SemiBold" FontSize="19" Foreground="#8A1F1F"/>
                <TextBlock x:Name="ErrorTextBlock" FontSize="14" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="UpdateButton" Content="Update" Click="UpdateButton_Click"
                        Padding="22,9" Background="#1E3A5F" Foreground="White" BorderThickness="0"
                        FontFamily="./Fonts/#Poppins SemiBold" FontSize="14" Cursor="Hand"/>
                <Button x:Name="RetryButton" Content="Retry" Click="UpdateButton_Click" Visibility="Collapsed"
                        Padding="22,9" Background="#1E3A5F" Foreground="White" BorderThickness="0"
                        FontFamily="./Fonts/#Poppins SemiBold" FontSize="14" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
