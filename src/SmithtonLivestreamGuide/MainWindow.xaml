<Window x:Class="SmithtonLivestreamGuide.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smithton Livestream Guide"
        Height="820" Width="880"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="./Fonts/#Poppins"
        Loaded="MainWindow_Loaded">

    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E3A5F"/>
            <Setter Property="Margin" Value="0,26,0,8"/>
        </Style>
        <Style x:Key="SubHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="./Fonts/#Poppins SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#B4690E"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style x:Key="BodyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Foreground" Value="#262A30"/>
            <Setter Property="Margin" Value="18,2,0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SubBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
            <Setter Property="Margin" Value="36,2,0,2"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="SubSubBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
            <Setter Property="Margin" Value="54,2,0,2"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="40" Height="22">
                                <Border x:Name="Track" CornerRadius="11" Background="#D1D5DB"/>
                                <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9" Background="White"
                                        HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="3" ShadowDepth="1"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#1E3A5F"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CopyButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ToolTip" Value="Copy"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CopyButtonBackground" Background="{TemplateBinding Background}" CornerRadius="4" Padding="4">
                            <Grid Width="13" Height="13">
                                <Rectangle Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Stroke="#6B7280" StrokeThickness="1.3" RadiusX="1.5" RadiusY="1.5"/>
                                <Rectangle Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                           Fill="#F5F6F8" Stroke="#6B7280" StrokeThickness="1.3" RadiusX="1.5" RadiusY="1.5"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OpenLinkButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Open in browser"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OpenLinkButtonBackground" Background="#EEF2F6" CornerRadius="10" Padding="8,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Open" FontFamily="./Fonts/#Poppins SemiBold" FontSize="11.5" Foreground="#1E3A5F" VerticalAlignment="Center"/>
                                <Path Data="M 2,10 L 10,2 M 5,2 L 10,2 L 10,7" Stroke="#1E3A5F" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="10" Height="10" Stretch="Uniform" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OpenLinkButtonBackground" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E3E5E9" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Smithton Livestream Guide" FontSize="24" FontWeight="Bold" Foreground="#16324F"/>
                    <TextBlock Text="Step-by-step reference for running the Sunday livestream." FontSize="13" Foreground="#6B7280" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Foreground="#2B2F36" HorizontalAlignment="Right"
                              Checked="StartWithWindowsCheckBox_Changed" Unchecked="StartWithWindowsCheckBox_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="GuideScrollViewer" VerticalScrollBarVisibility="Auto" Padding="24,10,24,30"
                      PreviewMouseWheel="GuideScrollViewer_PreviewMouseWheel">
            <StackPanel>

                <TextBlock Text="Initial Setup" Style="{StaticResource SectionHeaderStyle}"/>

                <TextBlock Text="Power on" Style="{StaticResource SubHeaderStyle}"/>
                <TextBlock Text="• Switch on all power under the desk - this is part of the sound system" Style="{StaticResource SubBodyStyle}"/>
                <TextBlock Text="• Make sure the big red switch is on" Style="{StaticResource SubBodyStyle}"/>
                <TextBlock Text="• Make sure the little black switch is on" Style="{StaticResource SubBodyStyle}"/>

                <TextBlock Text="Turn Each of the 3 cameras on" Style="{StaticResource SubHeaderStyle}"/>
                <TextBlock Text="• Using the DataVideo Remote" Style="{StaticResource SubBodyStyle}"/>
                <TextBlock Text="• Press Cam 1 - Point at Centre Camera and Press Red Power Button" Style="{StaticResource SubSubBodyStyle}"/>
                <TextBlock Text="• Press Cam 2 - Point at Pulpit Camera and Press Red Power Button" Style="{StaticResource SubSubBodyStyle}"/>
                <TextBlock Text="• Press Cam 3 - Point at Side Camera and Press Red Power Button" Style="{StaticResource SubSubBodyStyle}"/>

                <TextBlock Text="Lights" Style="{StaticResource SubHeaderStyle}"/>
                <TextBlock Text="• On the Cameo switcher - slide the master to full (push up) - this will enable the pulpit lighting" Style="{StaticResource SubBodyStyle}"/>

                <TextBlock Text="Login to the Laptop" Style="{StaticResource SubHeaderStyle}"/>
                <TextBlock Text="• Open EasyWorship" Style="{StaticResource SubBodyStyle}"/>
                <TextBlock Text="• Open Browser Bookmark for Restream" Style="{StaticResource SubBodyStyle}"/>
                <TextBlock Text="• Open Browser Bookmark for RTMP Web Player" Style="{StaticResource SubBodyStyle}"/>

                <TextBlock Text="EasyWorship" Style="{StaticResource SubHeaderStyle}"/>
                <TextBlock Text="• Select the &quot;Welcome to Smithton Church&quot; slide" Style="{StaticResource SubBodyStyle}"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Restream" Style="{StaticResource SubHeaderStyle}"/>
                    <Button Style="{StaticResource OpenLinkButtonStyle}" VerticalAlignment="Center" Margin="8,0,0,0"
                            Tag="https://app.restream.io/home" Click="OpenLinkButton_Click"/>
                </StackPanel>
                <TextBlock Text="• Update the titles for Youtube &amp; Facebook" Style="{StaticResource SubBodyStyle}"/>
                <TextBlock Text="• Click &quot;Update Titles&quot;" Style="{StaticResource SubSubBodyStyle}"/>
                <TextBlock Text="• Title: Get from sermon title / church notices" Style="{StaticResource SubSubBodyStyle}"/>
                <TextBlock Text="• Description: Input the preacher's name - can also be found in the church notices" Style="{StaticResource SubSubBodyStyle}"/>
                <TextBlock Text="• Click &quot;Update All&quot;" Style="{StaticResource SubSubBodyStyle}"/>
                <TextBlock Text="• Ensure Youtube &amp; Facebook are enabled for receiving the stream" Style="{StaticResource SubBodyStyle}"/>
                <TextBlock Text="• Ensure the toggle button is &quot;on&quot; - it should show as blue" Style="{StaticResource SubSubBodyStyle}"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="RTMP Web Player" Style="{StaticResource SubHeaderStyle}"/>
                    <Button Style="{StaticResource OpenLinkButtonStyle}" VerticalAlignment="Center" Margin="8,0,0,0"
                            Tag="https://stream.rossmackenzie.co.uk" Click="OpenLinkButton_Click"/>
                </StackPanel>
                <TextBlock Text="• Click 'Login' in the top right corner" Style="{StaticResource SubBodyStyle}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SubSubBodyStyle}">• Email is '<Run FontWeight="Bold">office@smithtonchurch.com</Run>'</TextBlock>
                    <Button Style="{StaticResource CopyButtonStyle}" VerticalAlignment="Center" Margin="4,0,0,0"
                            Tag="office@smithtonchurch.com" Click="CopyButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SubSubBodyStyle}">• Password is '<Run FontWeight="Bold">smithtonfr33</Run>'</TextBlock>
                    <Button Style="{StaticResource CopyButtonStyle}" VerticalAlignment="Center" Margin="4,0,0,0"
                            Tag="smithtonfr33" Click="CopyButton_Click"/>
                </StackPanel>
                <TextBlock Text="• Open the channel called 'Smithton Free Church'" Style="{StaticResource SubBodyStyle}"/>
                <TextBlock Text="• Make sure the thumbnail is set to the correct slide" Style="{StaticResource SubBodyStyle}"/>
                <TextBlock Text="• Welcome to Smithton Church slide for Sundays" Style="{StaticResource SubSubBodyStyle}"/>
                <TextBlock Text="• Church Night Livestream slide for Wednesdays" Style="{StaticResource SubSubBodyStyle}"/>
                <TextBlock Text="• Then update the titles, making them the same as Restream" Style="{StaticResource SubBodyStyle}"/>
                <TextBlock Text="• Make sure 'Recordings' is toggled ON" Style="{StaticResource SubBodyStyle}"/>

                <TextBlock Text="Camera Position" Style="{StaticResource SubHeaderStyle}"/>
                <TextBlock Text="• Get each camera into position" Style="{StaticResource SubBodyStyle}"/>
                <TextBlock Text="• Balance the colour" Style="{StaticResource SubBodyStyle}"/>

                <TextBlock Text="T-15 mins" Style="{StaticResource SectionHeaderStyle}"/>

                <TextBlock Text="Start Streaming" Style="{StaticResource SubHeaderStyle}"/>
                <TextBlock Text="• Pre-Checks" Style="{StaticResource SubBodyStyle}"/>
                <TextBlock Text="• Confirm the Opening Slide is the Welcome Slide in EasyWorship" Style="{StaticResource SubSubBodyStyle}"/>
                <TextBlock Text="• Confirm you have cut to &quot;Laptop&quot; on the BlackMagic Panel" Style="{StaticResource SubSubBodyStyle}"/>
                <TextBlock Text="• Double check the audio - you can just leave the church mic on" Style="{StaticResource SubSubBodyStyle}"/>
                <TextBlock Text="• Go Live" Style="{StaticResource SubBodyStyle}"/>
                <TextBlock Text="• On the ATEM BlackMagic panel - click &quot;ON AIR&quot; - top right" Style="{StaticResource SubSubBodyStyle}"/>
                <TextBlock Text="• On RTMP Web Player wait 20-30 seconds, then check that the stream has come through" Style="{StaticResource SubSubBodyStyle}"/>
                <TextBlock Text="• Post-Checks" Style="{StaticResource SubBodyStyle}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="• Go on YouTube - confirm we are live" Style="{StaticResource SubSubBodyStyle}"/>
                    <Button Style="{StaticResource OpenLinkButtonStyle}" VerticalAlignment="Center" Margin="6,0,0,0"
                            Tag="https://www.youtube.com/@SmithtonChurchVideo" Click="OpenLinkButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="• Go on Facebook - confirm we are live" Style="{StaticResource SubSubBodyStyle}"/>
                    <Button Style="{StaticResource OpenLinkButtonStyle}" VerticalAlignment="Center" Margin="6,0,0,0"
                            Tag="https://www.facebook.com/smithtonchurch/" Click="OpenLinkButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="• Go on website (smithtonchurch.com) - confirm we are live" Style="{StaticResource SubSubBodyStyle}"/>
                    <Button Style="{StaticResource OpenLinkButtonStyle}" VerticalAlignment="Center" Margin="6,0,0,0"
                            Tag="https://smithtonchurch.com" Click="OpenLinkButton_Click"/>
                </StackPanel>

                <Border Background="#FEF6E0" BorderBrush="#F0CB6B" BorderThickness="1.5" CornerRadius="6" Padding="16,12" Margin="0,26,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" Background="#D9A106"
                                VerticalAlignment="Top" Margin="0,1,10,0">
                            <TextBlock Text="i" FontFamily="./Fonts/#Poppins SemiBold" FontSize="13" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="BEFORE GOING OFF AIR, MAKE SURE THE RTMP WEB PLAYER HAS CAUGHT UP - THERE IS A MINIMUM 20 SECOND DELAY."
                                   FontWeight="Bold" FontSize="14.5" Foreground="#7A5A00" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
